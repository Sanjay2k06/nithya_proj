APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database URL: PostgreSQL or SQLite fallback for development
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/forest_fire_db
# SQLite fallback example:
DATABASE_URL=sqlite:///./runtime/forest_fire.db

MODEL_PATH=artifacts/checkpoints/firenet_best.pt
MODEL_DEVICE=auto
MODEL_DEMO_MODE=false

IMAGE_SIZE=224
FIRE_THRESHOLD=0.75
SMOKE_THRESHOLD=0.70
TEMPORAL_WINDOW=5
TEMPORAL_REQUIRED_POSITIVES=3
ALERT_COOLDOWN_SECONDS=60

MAX_UPLOAD_MB=25
MAX_VIDEO_SECONDS=120
MEDIA_ROOT=./runtime/media

NOTIFICATION_PROVIDER=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
